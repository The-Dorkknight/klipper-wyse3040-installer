# hostapd config for the default-on hotspot (WIFI_MODE=ap).
# ssid= gets rewritten per-unit by late-command.sh to Klipper-<mac suffix>.
# __WIFI_PASSPHRASE__ and __COUNTRY__ are filled in at build time — baked
# into every unit imaged from the resulting ISO.
interface=wlan0
driver=nl80211

ssid=Klipper-Print
hw_mode=g
channel=6
ieee80211n=1
wmm_enabled=1

auth_algs=1
macaddr_acl=0
ignore_broadcast_ssid=0

wpa=2
wpa_key_mgmt=WPA-PSK
wpa_passphrase=__WIFI_PASSPHRASE__
rsn_pairwise=CCMP

# Country code affects legal channel/power limits — set to where the units
# will actually run. No longer hard-coded: the GUI validates this against
# ISO 3166 the same way it validates the Pi hotspot tool's country field,
# because shipping every unit with a wrong regulatory domain is a real
# correctness bug, not a cosmetic one.
country_code=__COUNTRY__
ieee80211d=1
