server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root __WEBUI_ROOT__;
    index index.html;

    access_log off;
    error_log /var/log/nginx/webui-error.log warn;

    client_max_body_size 200M;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Boot diagnostics (see systemd/wyse-diag.service): a soldered eMMC can't
    # be pulled out and remounted on another PC the way an SD card can, so
    # instead of writing to a boot partition, the report is just served here.
    location = /diagnostics.txt {
        alias __DIAG_FILE__;
        default_type text/plain;
        add_header Cache-Control "no-store";
    }

    location /websocket {
        proxy_pass http://127.0.0.1:7125/websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location ~ ^/(printer|api|access|machine|server)/ {
        proxy_pass http://127.0.0.1:7125;
        proxy_set_header Host $http_host;
    }
}
