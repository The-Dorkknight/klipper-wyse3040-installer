# Build-time options, rendered by wyse_injector.py (or setup.sh) and sourced
# by late-command.sh inside the target during provisioning. Keeping these in
# one file — instead of hard-coding choices into late-command.sh — is what
# lets one GUI build produce different units (AP vs station WiFi, Mainsail
# vs Fluidd, Crowsnest on/off, KlipPlug on/off) from the same overlay.
WEBUI="__WEBUI__"                 # mainsail | fluidd
CROWSNEST="__CROWSNEST__"         # 0 | 1
KLIPPLUG="__KLIPPLUG__"           # 0 | 1  (optional plugin manager, experimental)
WIFI_MODE="__WIFI_MODE__"         # ap | station
STATION_SSID="__STATION_SSID__"   # only used when WIFI_MODE=station
STATION_PASSWORD="__STATION_PASSWORD__"
COUNTRY="__COUNTRY__"             # 2-letter WiFi regulatory domain, e.g. GB, US, DE
HOSTNAME_PREFIX="__HOSTNAME_PREFIX__"
